              "name": "API LaRutica",
              "description": "Rutas del servidor: inicio de sesión, checkout, pago, perfil y reservas. Decide por sesión, rol y propiedad; usa credenciales separadas para Supabase y Onvo.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "df10f8f4-4c28-432c-ad1a-0b983c8ef86c",
                  "title": "T-02 Manipulación de pasajero, precio o importe",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "F-02: Un checkout adulterado permite comprar para otra identidad o confirmar una reserva por menos. Alta: afecta ingresos y disponibilidad.",
                  "mitigation": "Fijar pasajero desde la sesión, recalcular importe en servidor y verificar estado, importe y moneda de Onvo antes de confirmar.",
