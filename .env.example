# Solo para ejecutar un backend propio. Un clon normal no necesita este archivo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Solo servidor. Nunca uses NEXT_PUBLIC_ con esta clave ni la subas a Git.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR

# Solo servidor. Necesaria para el asistente de IA (/api/assistant).
DEEPSEEK_API_KEY=sk-REEMPLAZAR

# Solo servidor. Configurar en el backend que ejecuta las API, no en el frontend.
# 465 = TLS directo; 587 = STARTTLS. Nunca desactivar la validación del certificado.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REEMPLAZAR
SMTP_PASS=REEMPLAZAR
MAIL_FROM=LaRutica <correo@example.com>

# STARTTLS obligatorio por defecto en conexiones sin TLS directo.
SMTP_REQUIRE_TLS=true
# Tiempos máximos en milisegundos; evitan bloquear reservas ante un SMTP caído.
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000

# Sites usa HTTPS hacia la función mail-relay de este mismo proyecto Supabase.
# El relay envía por Gmail/TLS 465. Dejar ambas vacías para usar SMTP directo en Node.
# MAIL_RELAY_URL=https://TU-PROYECTO.supabase.co/functions/v1/mail-relay
# MAIL_RELAY_TOKEN=SECRETO_GENERADO_SOLO_EN_EL_SERVIDOR

# Compatibilidad con nombres anteriores usados por este repositorio:
# NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# SUPABASE_SERVICE_ROLE_KEY=eyJ_REEMPLAZAR
